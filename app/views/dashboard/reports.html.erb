<div class="container-fluid reports-page">
  <div class="fbr-page-header d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h1 class="h3 mb-0"><i class="fas fa-chart-bar text-primary"></i> Reports</h1>
      <p class="text-muted mb-0">
        <%= @start_date.strftime('%d %b %Y') %> — <%= @end_date.strftime('%d %b %Y') %>
      </p>
    </div>
    <%= link_to dashboard_path, class: 'btn btn-outline-secondary btn-sm' do %>
      <i class="fas fa-arrow-left"></i> Dashboard
    <% end %>
  </div>

  <%= form_with url: reports_path, method: :get, local: true, html: auto_filter_form_options(html_class: 'card mb-4') do |f| %>
    <div class="card-body">
      <div class="row g-3 align-items-end">
        <div class="col-md-3">
          <%= f.label :start_date, 'From date', class: 'form-label' %>
          <%= f.date_field :start_date, value: @start_date, class: 'form-control', **auto_filter_change_options %>
        </div>
        <div class="col-md-3">
          <%= f.label :end_date, 'To date', class: 'form-label' %>
          <%= f.date_field :end_date, value: @end_date, class: 'form-control', **auto_filter_change_options %>
        </div>
        <div class="col-md-3">
          <%= button_to 'Compliance export', compliance_exports_path(start_date: @start_date, end_date: @end_date), method: :post, class: 'btn btn-outline-info w-100', form: { data: { turbo: false } } %>
        </div>
        <div class="col-md-3">
          <%= link_to 'Export CSV', reports_path(format: :csv, start_date: @start_date, end_date: @end_date), class: 'btn btn-outline-success w-100' %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="row g-3 mb-3">
    <div class="col-12">
      <h6 class="text-muted text-uppercase small fw-semibold mb-0">Approved invoices</h6>
    </div>
    <div class="col-md-6 col-lg-3">
      <div class="card fbr-stat-card h-100 border-success border-opacity-25"><div class="card-body py-3">
        <small class="text-muted">Approved count</small>
        <div class="h4 mb-0 text-success"><%= @summary[:approved][:count] %></div>
      </div></div>
    </div>
    <div class="col-md-6 col-lg-3">
      <div class="card fbr-stat-card h-100 border-success border-opacity-25"><div class="card-body py-3">
        <small class="text-muted">Approved net amount</small>
        <div class="h6 mb-0 text-success"><%= format_pkr(@summary[:approved][:net_amount]) %></div>
      </div></div>
    </div>
    <div class="col-md-6 col-lg-3">
      <div class="card fbr-stat-card h-100 border-success border-opacity-25"><div class="card-body py-3">
        <small class="text-muted">Approved total (incl. tax)</small>
        <div class="h6 mb-0 text-success"><%= format_pkr(@summary[:approved][:total_amount]) %></div>
      </div></div>
    </div>
    <div class="col-md-6 col-lg-3">
      <div class="card fbr-stat-card h-100 border-success border-opacity-25"><div class="card-body py-3">
        <small class="text-muted">Approved sales tax</small>
        <div class="h6 mb-0 text-success"><%= format_pkr(@summary[:approved][:tax_amount]) %></div>
      </div></div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-12">
      <h6 class="text-muted text-uppercase small fw-semibold mb-0">Failed / cancelled invoices</h6>
    </div>
    <div class="col-md-6 col-lg-3">
      <div class="card fbr-stat-card h-100 border-danger border-opacity-25"><div class="card-body py-3">
        <small class="text-muted">Failed / cancelled count</small>
        <div class="h4 mb-0 text-danger"><%= @summary[:failed_cancelled][:count] %></div>
      </div></div>
    </div>
    <div class="col-md-6 col-lg-3">
      <div class="card fbr-stat-card h-100 border-danger border-opacity-25"><div class="card-body py-3">
        <small class="text-muted">Failed / cancelled total</small>
        <div class="h6 mb-0 text-danger"><%= format_pkr(@summary[:failed_cancelled][:total_amount]) %></div>
      </div></div>
    </div>
    <div class="col-md-6 col-lg-3">
      <div class="card fbr-stat-card h-100 border-danger border-opacity-25"><div class="card-body py-3">
        <small class="text-muted">Failed / cancelled tax</small>
        <div class="h6 mb-0 text-danger"><%= format_pkr(@summary[:failed_cancelled][:tax_amount]) %></div>
      </div></div>
    </div>
    <div class="col-md-6 col-lg-3">
      <div class="card fbr-stat-card h-100"><div class="card-body py-3">
        <small class="text-muted">All invoices / FBR / Draft</small>
        <div class="h6 mb-0">
          <%= @summary[:total_invoices] %>
          <span class="text-muted">·</span>
          <span class="text-success"><%= @summary[:fbr_submitted] %> FBR</span>
          <span class="text-muted">·</span>
          <span class="text-secondary"><%= @summary[:draft] %> draft</span>
        </div>
      </div></div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-6">
      <div class="card h-100">
        <div class="card-header bg-white fw-semibold">Daily totals — approved</div>
        <div class="card-body p-0">
          <% if @daily_summary.any? %>
            <div class="table-responsive" style="max-height: 360px;">
              <table class="table table-hover mb-0">
                <thead><tr><th>Date</th><th class="text-end">Amount (Rs.)</th></tr></thead>
                <tbody>
                  <% @daily_summary.each do |date, total| %>
                    <tr>
                      <td><%= date.is_a?(Date) ? date.strftime('%d %b %Y') : date %></td>
                      <td class="text-end text-success"><%= format_pkr(total) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted p-4 mb-0">No approved invoices in this date range.</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card h-100">
        <div class="card-header bg-white fw-semibold">Daily totals — failed / cancelled</div>
        <div class="card-body p-0">
          <% if @failed_daily_summary.any? %>
            <div class="table-responsive" style="max-height: 360px;">
              <table class="table table-hover mb-0">
                <thead><tr><th>Date</th><th class="text-end">Amount (Rs.)</th></tr></thead>
                <tbody>
                  <% @failed_daily_summary.each do |date, total| %>
                    <tr>
                      <td><%= date.is_a?(Date) ? date.strftime('%d %b %Y') : date %></td>
                      <td class="text-end text-danger"><%= format_pkr(total) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted p-4 mb-0">No failed or cancelled invoices in this date range.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4 mt-0">
    <div class="col-lg-12">
      <div class="card h-100">
        <div class="card-header bg-white fw-semibold">Top buyers — approved</div>
        <div class="card-body p-0">
          <% if @customer_summary.any? %>
            <div class="table-responsive" style="max-height: 360px;">
              <table class="table table-hover mb-0">
                <thead><tr><th>Buyer</th><th class="text-end">Total (Rs.)</th></tr></thead>
                <tbody>
                  <% @customer_summary.each do |name, total| %>
                    <tr>
                      <td><%= name.presence || 'Unknown' %></td>
                      <td class="text-end text-success"><%= format_pkr(total) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted p-4 mb-0">No buyer data in this date range.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if @invoices.any? %>
    <div class="card mt-4">
      <div class="card-header bg-white fw-semibold">All invoices in period</div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th>Invoice #</th>
                <th>Date</th>
                <th>Buyer</th>
                <th class="text-end">Tax</th>
                <th class="text-end">Total</th>
                <th>Status</th>
                <th>Environment</th>
                <th>FBR</th>
              </tr>
            </thead>
            <tbody>
              <% @invoices.each do |inv| %>
                <tr>
                  <td><%= link_to inv.invoice_number, invoice_path(inv) %></td>
                  <td><%= inv.invoice_date.strftime('%d %b %Y') %></td>
                  <td><%= inv.buyer_name.presence || '—' %></td>
                  <td class="text-end"><%= format_pkr(inv.tax_amount) %></td>
                  <td class="text-end fw-semibold"><%= format_pkr(inv.total_amount) %></td>
                  <td><%= render 'shared/status_badge', status: inv.status %></td>
                  <td><%= render 'shared/invoice_environment_badge', invoice: inv %></td>
                  <td>
                    <% if inv.fbr_invoice_id.present? %>
                      <span class="badge bg-success">Submitted</span>
                    <% else %>
                      <span class="badge bg-secondary">—</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
</div>
