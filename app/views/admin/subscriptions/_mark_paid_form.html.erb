<% if taxpayer.subscription_free_forever? %>
  <span class="text-muted small">Free forever</span>
<% else %>
  <%= form_with url: mark_paid_admin_subscription_path(taxpayer), method: :patch, local: true, class: 'subscription-paid-form mb-2' do %>
    <div class="d-flex flex-wrap gap-1 mb-2">
      <% Subscriptions::Manager::PERIOD_OPTIONS.each do |label, months| %>
        <%= button_tag "+#{months}m",
            type: 'submit',
            name: 'period',
            value: label,
            class: 'btn btn-sm btn-outline-success',
            data: { disable_with: '…' },
            title: "Extend #{months} month(s) · #{format_pkr(months * taxpayer.monthly_subscription_fee)}" %>
      <% end %>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-end">
      <div>
        <label class="form-label small mb-1" for="active_until_<%= taxpayer.id %>">Extend until</label>
        <%= date_field_tag :active_until,
            taxpayer.default_subscription_extension_date,
            id: "active_until_#{taxpayer.id}",
            class: 'form-control form-control-sm',
            min: Date.current %>
      </div>
      <%= submit_tag 'Record paid', class: 'btn btn-sm btn-success', data: { disable_with: 'Saving…' } %>
    </div>
  <% end %>

  <% if taxpayer.subscription_reducible? %>
    <%= form_with url: reduce_months_admin_subscription_path(taxpayer), method: :patch, local: true, class: 'subscription-reduce-form' do %>
      <div class="d-flex flex-wrap gap-1 mb-2">
        <% Subscriptions::Manager::REDUCE_PERIOD_OPTIONS.each do |label, months| %>
          <%= button_tag "−#{months}m",
              type: 'submit',
              name: 'reduce_period',
              value: label,
              class: 'btn btn-sm btn-outline-danger',
              data: { disable_with: '…' },
              title: "Reduce #{months} month(s)" %>
        <% end %>
      </div>
      <div class="d-flex flex-wrap gap-2 align-items-end">
        <div>
          <label class="form-label small mb-1" for="reduce_active_until_<%= taxpayer.id %>">Reduce to</label>
          <%= date_field_tag :reduce_active_until,
              [taxpayer.subscription_active_until - 1.month, Date.current].max,
              id: "reduce_active_until_#{taxpayer.id}",
              class: 'form-control form-control-sm',
              max: taxpayer.subscription_active_until - 1.day %>
        </div>
        <%= submit_tag 'Reduce', class: 'btn btn-sm btn-outline-danger', data: { disable_with: 'Saving…' } %>
      </div>
    <% end %>
  <% end %>

  <small class="text-muted d-block mt-1">
    <%= format_pkr(taxpayer.monthly_subscription_fee) %> / month
    <% if taxpayer.subscription_active? %>
      · <%= taxpayer.subscription_days_remaining %> day(s) left
    <% end %>
  </small>
<% end %>
