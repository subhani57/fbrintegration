<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
  <div>
    <h1 class="fbr-page-header mb-1"><%= @taxpayer.email %></h1>
    <p class="text-muted mb-0"><%= @taxpayer.business_name.presence || 'Taxpayer subscription' %></p>
  </div>
  <div class="d-flex gap-2">
    <% unless @taxpayer.subscription_free_forever? %>
      <%= button_to mark_free_forever_admin_subscription_path(@taxpayer),
          method: :patch,
          class: 'btn btn-outline-info',
          form: { data: confirm_form_data("Mark #{@taxpayer.email} as free forever? They will never need to pay subscription fees.") } do %>
        <i class="fas fa-infinity"></i> Forever Free
      <% end %>
    <% end %>
    <%= link_to admin_user_path(@taxpayer), class: 'btn btn-outline-secondary' do %>
      <i class="fas fa-user"></i> User profile
    <% end %>
    <%= link_to admin_subscriptions_path, class: 'btn btn-outline-secondary' do %>
      <i class="fas fa-arrow-left"></i> All subscriptions
    <% end %>
  </div>
</div>

<% if params[:download_receipt].present? %>
  <div data-controller="receipt-download"
       data-receipt-download-url-value="<%= admin_subscription_payment_receipt_path(params[:download_receipt]) %>"
       hidden></div>
<% end %>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Current status</strong>
        <%= subscription_status_badge(@taxpayer) %>
      </div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-5">Status</dt>
          <dd class="col-sm-7"><%= @taxpayer.subscription_status_label %></dd>
          <dt class="col-sm-5">Active until</dt>
          <dd class="col-sm-7">
            <% if @taxpayer.subscription_free_forever? %>
              <span class="text-info fw-semibold">Never expires</span>
            <% else %>
              <%= @taxpayer.subscription_active_until&.strftime('%d %B %Y') || '—' %>
            <% end %>
          </dd>
          <dt class="col-sm-5">Days remaining</dt>
          <dd class="col-sm-7">
            <% if @taxpayer.subscription_free_forever? %>
              <span class="text-info fw-semibold">Unlimited</span>
            <% elsif @taxpayer.subscription_active? %>
              <%= @taxpayer.subscription_days_remaining %> day(s)
            <% else %>
              <span class="text-danger">Expired</span>
            <% end %>
          </dd>
          <dt class="col-sm-5">Monthly fee</dt>
          <dd class="col-sm-7"><%= format_pkr(@taxpayer.monthly_subscription_fee) %></dd>
          <% if @taxpayer.subscription_plan %>
            <dt class="col-sm-5">Plan</dt>
            <dd class="col-sm-7"><%= @taxpayer.subscription_plan.name %></dd>
          <% end %>
        </dl>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-header"><strong>Quick extend</strong></div>
      <div class="card-body">
        <% if @taxpayer.subscription_free_forever? %>
          <p class="text-muted mb-0 small">This account has forever free access. No payments are required.</p>
        <% else %>
          <%= render 'admin/subscriptions/mark_paid_form', taxpayer: @taxpayer %>
        <% end %>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><strong>Generate receipt</strong></div>
      <div class="card-body">
        <% if @taxpayer.subscription_free_forever? %>
          <p class="text-muted mb-0 small">Receipts are not required for forever free accounts.</p>
        <% else %>
          <p class="text-muted small">Creates an unpaid receipt for the customer. Subscription is activated only after you mark it paid.</p>
          <%= render 'admin/subscriptions/generate_receipt_form', taxpayer: @taxpayer %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Payment history</strong>
        <span class="badge bg-secondary"><%= @taxpayer.subscription_payments.count %> total</span>
      </div>
      <div class="card-body p-0">
        <% if @subscription_payments.any? %>
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th>Date</th>
                <th>Receipt</th>
                <th>Status</th>
                <th>Breakdown</th>
                <th>Amount</th>
                <th>Active until</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @subscription_payments.each do |payment| %>
                <tr>
                  <td class="text-nowrap"><%= payment.created_at.strftime('%d %b %Y') %></td>
                  <td>
                    <% if payment.receipt_number.present? %>
                      <%= link_to payment.receipt_number,
                          admin_subscription_payment_receipt_path(payment),
                          class: 'small fw-semibold',
                          data: { turbo: false } %>
                    <% else %>
                      —
                    <% end %>
                  </td>
                  <td>
                    <% if payment.pending? %>
                      <span class="badge bg-warning text-dark">Unpaid</span>
                    <% else %>
                      <span class="badge bg-success">Paid</span>
                    <% end %>
                  </td>
                  <td class="small">
                    <% if payment.line_items.any? %>
                      <% payment.line_items.each do |item| %>
                        <div><%= item.description %> · <%= format_pkr(item.amount) %></div>
                      <% end %>
                    <% elsif payment.months.present? && payment.monthly_fee.present? %>
                      <%= payment.months %> mo × <%= format_pkr(payment.monthly_fee) %>
                    <% else %>
                      <span class="text-muted"><%= payment.notes.presence || 'Subscription payment' %></span>
                    <% end %>
                  </td>
                  <td class="fw-semibold"><%= format_pkr(payment.amount) %></td>
                  <td><%= payment.active_until.strftime('%d %b %Y') %></td>
                  <td class="text-end text-nowrap">
                    <% if payment.pending? %>
                      <%= button_to 'Mark paid',
                          admin_mark_subscription_payment_paid_path(payment),
                          method: :patch,
                          class: 'btn btn-sm btn-success',
                          form: { data: confirm_form_data("Mark receipt #{payment.receipt_number} as paid? This will activate the user's subscription until #{payment.active_until.strftime('%d %b %Y')}.") } %>
                    <% else %>
                      <span class="small text-muted"><%= payment.recorded_by&.email || '—' %></span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="p-4 text-muted mb-0">No payments recorded yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
