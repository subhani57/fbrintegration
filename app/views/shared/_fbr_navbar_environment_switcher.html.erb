<%# Read-only FBR environment badge for taxpayers — switching is admin-only %>
<% if user_signed_in? && current_user.taxpayer? && current_user.can_manage_invoices? %>
  <li class="nav-item d-flex align-items-center fbr-env-switcher-wrap" id="fbr-env-switcher">
    <span class="fbr-env-switcher__btn fbr-env-switcher__btn--active <%= 'fbr-env-switcher__btn--production' if current_user.default_fbr_environment == 'production' %>"
          title="FBR <%= current_user.default_fbr_environment.humanize %> (managed by administrator)">
      <% if current_user.default_fbr_environment == 'production' %>
        <i class="fas fa-broadcast-tower"></i>
      <% else %>
        <i class="fas fa-flask"></i>
      <% end %>
      <span class="fbr-env-switcher__text"><%= current_user.default_fbr_environment.humanize %></span>
    </span>
  </li>
<% end %>
